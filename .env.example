# Environment Variables for ParkCheck
# Security Note: Never commit production credentials.

# Database URL - PostgreSQL connection string
# For local development/testing without docker, a remote PostgreSQL instance or test connection string can be supplied:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/parkcheck?schema=public"

# Authentication secret
SESSION_SECRET="parkcheck-dev-secret-minimum-32-chars-long-development-only"

# Storage driver: local (stores in ./uploads) | s3
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"

# Base app URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
