# ParkCheck - Staging Environment Configuration Template
# COPY THIS FILE TO .env.staging ON YOUR SECURE STAGING HOST. NEVER COMMIT SECRETS TO GIT.

# ==========================================
# 1. Dedicated Staging Database (PostgreSQL)
# ==========================================
# MUST point to a dedicated staging PostgreSQL instance, completely separated from production.
# Ensure SSL mode is enabled (sslmode=require) in cloud/remote environments.
DATABASE_URL="postgresql://parkcheck_staging:CHANGEME_STAGING_PASSWORD@staging-db-host:5432/parkcheck_staging?schema=public&sslmode=prefer"

# ==========================================
# 2. Authentication & Session Security
# ==========================================
# High-entropy random secret (minimum 32 characters) used to sign guard & supervisor JWT session tokens.
# Generate via: openssl rand -base64 32
SESSION_SECRET="CHANGEME_MINIMUM_32_CHAR_CRYPTOGRAPHIC_SECRET_STAGING"

# ==========================================
# 3. Durable Attachment Storage
# ==========================================
# Driver: 'local' (with persistent volume mount) OR 's3' (object storage)
STORAGE_DRIVER="local"

# If STORAGE_DRIVER="local":
# Persistent volume path on the staging host.
UPLOAD_DIR="./uploads"

# If STORAGE_DRIVER="s3":
# S3_BUCKET="parkcheck-staging-attachments"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID="CHANGEME_AWS_ACCESS_KEY"
# S3_SECRET_ACCESS_KEY="CHANGEME_AWS_SECRET_KEY"
# S3_ENDPOINT="" # Optional: for Cloudflare R2, MinIO, or Wasabi

# ==========================================
# 4. Networking & Service URLs
# ==========================================
NODE_ENV="production"
PORT=3000
NEXT_PUBLIC_APP_URL="https://staging.parkcheck.internal"
